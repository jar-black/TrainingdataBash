{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bash Tool-Calling Training Example",
  "description": "Schema for multi-turn bash tool-calling conversation examples",
  "type": "object",
  "required": ["id", "conversations"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the example",
      "pattern": "^[a-z0-9_]+$"
    },
    "conversations": {
      "type": "array",
      "description": "Array of conversation turns",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant", "tool"]
          },
          "content": {
            "type": ["string", "null"],
            "description": "Text content of the message (null when assistant makes tool call)"
          },
          "tool_calls": {
            "type": "array",
            "description": "Tool calls made by the assistant",
            "items": {
              "type": "object",
              "required": ["id", "type", "function"],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier for this tool call"
                },
                "type": {
                  "type": "string",
                  "enum": ["function"]
                },
                "function": {
                  "type": "object",
                  "required": ["name", "arguments"],
                  "properties": {
                    "name": {
                      "type": "string",
                      "enum": ["bash"],
                      "description": "The tool name (always 'bash' for this dataset)"
                    },
                    "arguments": {
                      "type": "string",
                      "description": "JSON string containing the command argument"
                    }
                  }
                }
              }
            }
          },
          "tool_call_id": {
            "type": "string",
            "description": "ID of the tool call this result corresponds to (for tool role)"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "role": { "const": "tool" } }
            },
            "then": {
              "required": ["tool_call_id", "content"]
            }
          },
          {
            "if": {
              "properties": { "role": { "const": "system" } }
            },
            "then": {
              "required": ["content"]
            }
          },
          {
            "if": {
              "properties": { "role": { "const": "user" } }
            },
            "then": {
              "required": ["content"]
            }
          }
        ]
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata about the example",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "file_operations",
            "text_processing",
            "permissions",
            "process_management",
            "system_info",
            "network",
            "archive",
            "package_management",
            "git",
            "user_environment",
            "mixed_complex"
          ]
        },
        "commands_used": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of bash commands used in this example"
        },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard"],
          "description": "Difficulty level of the task"
        },
        "turns": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of conversation turns"
        },
        "has_error_recovery": {
          "type": "boolean",
          "description": "Whether this example includes error handling"
        },
        "uses_pipes": {
          "type": "boolean",
          "description": "Whether commands use piping"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Additional tags for categorization"
        }
      }
    }
  }
}
